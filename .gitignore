.DS_Store
*.zip
downloaded_models

# Externally downloaded model checkpoints in inference-containers folders
# (served locally via -m/--model-path, never committed)
# NOTE: this also matches vendored vllm overlay files under
# recipe/overlay/vllm/models/ and .../model_executor/models/ — a plain
# `git add` silently skips them. If you add recipe files under a models/ path,
# use `git add -f` (variant03 hit this on a fresh clone; see to_be_continued.md).
inference-containers/**/models/
.aider.*

# The .env file is ignored because it often contains private API keys, so it should not be committed to a repo.
# However, it makes sense to commit files called .env.example that explain what the .env file should look like.
.env

# We do not want to commit binary files of vscode to the repo
dev-image/.vscode-server/bin
dev-image/.vscode-server/data
dev-image/.vscode-server/extensions
dev-image/.vscode-server/extensionsCache/

# vLLM model cache ignores
vllm/*/hf-cache/
.hf-cache

# Local env files - should never be committed, use *.example instead
**/00_env.sh

*.diff
*.orig
**/orig/
# Generated patch overlays (extracted/generated at runtime by 00_c_prepare_patches_and_ple.sh)
inference-containers/vllm/qwen-3.8-flash-next-dgx-spark/**/files/*_patched.py
inference-containers/vllm/qwen-3.8-flash-next-dgx-spark/**/files/ple_offload/

# Python cache files
__pycache__/
*.pyc
*.pyo

deleteMe*
cliCurllToolDump/deleteMe_*.html

package-lock.json

# Local opencode-ai CLI install (npm) — binaries, never committed
node_modules/
# Root-only manifest for the CLI above (sub-projects may keep their own package.json)
/package.json

# AI agent scratchpad — model thought distillates, never committed (see AGENTS.md)
# (directory is re-included before negating the .gitkeep, because git cannot
#  re-include a file whose parent directory is excluded)
model_chain_of_thought/*
!model_chain_of_thought/.gitkeep
!model_chain_of_thought/tasks/
model_chain_of_thought/tasks/*
!model_chain_of_thought/tasks/.gitkeep

# Scratchpad/analysis folders inside variants — never commit
inference-containers/vllm/deepseek-v4-flash-dgx-spark-cluster/*/chain_of_thought/