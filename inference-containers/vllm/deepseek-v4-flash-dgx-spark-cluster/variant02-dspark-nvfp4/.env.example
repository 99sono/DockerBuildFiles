# =============================================================================
# DeepSeek-V4-Flash DSpark NVFP4 KV — Dual DGX Spark Cluster Environment
# =============================================================================
# Copy to .env and edit for your network.
#   cp .env.example .env
# =============================================================================

# ---- General ----
INFERENCE_API_KEY="dummy-key"
INFERENCE_MODEL_ALIAS="deepseek-v4-flash-dspark"

# ---- DSpark model (different from standard DeepSeek-V4-Flash!) ----
DSPARK_MODEL="deepseek-ai/DeepSeek-V4-Flash-DSpark"
SERVED_MODEL_NAME="deepseek-v4-flash-dspark"

# ---- Cluster topology ----
MASTER_ADDR="10.0.1.1"           # spark01 Port 1 IP (head node)
MASTER_PORT="25000"

# ---- RoCE / InfiniBand (dual-port) ----
NCCL_IB_DISABLE="0"
NCCL_IB_HCA="rocep1s0f0,roceP2p1s0f0"
NCCL_IB_GID_INDEX="2,2"          # Head (spark01): typically "2,2"
NCCL_SOCKET_IFNAME="enP7s7"
GLOO_SOCKET_IFNAME="enP7s7"
TP_SOCKET_IFNAME="enP7s7"
NCCL_CROSS_NIC="1"
NCCL_IGNORE_CPU_AFFINITY="1"
NCCL_DEBUG="WARN"

# ---- Per-node VLLM_HOST_IP (fabric IP for ZeroMQ) ----
VLLM_HOST_IP="10.0.1.1"

# ---- CUDA compilation targets (GB10 = SM121) ----
TORCH_CUDA_ARCH_LIST="12.1a"
FLASHINFER_CUDA_ARCH_LIST="12.1a"

# ---- DSpark / NVFP4 tuning ----
MAX_MODEL_LEN="1048576"          # 1M — model's true YaRN ceiling
MAX_NUM_SEQS="12"
MAX_NUM_BATCHED_TOKENS="8192"
GPU_MEMORY_UTILIZATION="0.85"
MTP_NUM_TOKENS="3"               # DSpark speculative tokens (probabilistic)

VLLM_ALLOW_LONG_MAX_MODEL_LEN="1"
VLLM_USE_FLASHINFER_SAMPLER="1"
VLLM_USE_B12X_MOE="1"
VLLM_USE_B12X_WO_PROJECTION="1"
VLLM_DSPARK_GPU_REJECTED_CONTEXT_MASK="1"
VLLM_DSPARK_REPLICATE_MARKOV_W1="1"
VLLM_DSPARK_LOCAL_ARGMAX="1"
VLLM_DSPARK_CONFIDENCE_THRESHOLD="0.0"
VLLM_DSPARK_CONFIDENCE_SCHEDULER="off"
VLLM_DSPARK_FUSED_MARKOV_ARGMAX="0"
VLLM_DSPARK_HARDWARE_SCHEDULER_EARLY_STOP="1"
VLLM_DSV4_B12X_COMPRESSED_MLA="0"
