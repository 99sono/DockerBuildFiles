# =============================================================================
# DeepSeek-V4-Flash-0731 DSpark NVFP4 KV — Dual DGX Spark Cluster Environment
# =============================================================================
# SHARED / build-script environment. Copy to .env and edit for your network:
#   cp .env.example .env
#
# Per-node environments live in the suffixed examples (copy the relevant one):
#   spark01 (head):   cp env.example.head   head/.env
#   spark02 (worker): cp env.example.worker worker/.env
#
# 0731 = DeepSeek's OFFICIAL release (2026-07-31), MIT. Already pre-quantized on
# disk: FP4 MoE experts + FP8 (e4m3) everything else. No NVFP4 download needed —
# "NVFP4" here = the KV cache dtype (nvfp4_ds_mla) + B12X MoE backend in the image.
# Requires Patch 4 baked into the overlay (shared-experts gate_up_proj fix) or
# 0731 runs at ~half speed (32.7 -> 55.4 tok/s).
#
# Profile = upstream "CURRENT BEST" re-measured 2026-07-29:
#   1M context, 6 slots, gpu_memory_utilization 0.78, k=5.
# (12/0.85 boots fine but is the documented issue-#8 first-request OOM trigger.)
# =============================================================================

# ---- General ----
INFERENCE_API_KEY="dummy-key"
INFERENCE_MODEL_ALIAS="deepseek-v4-flash-0731"

# ---- 0731 official release (DSpark draft module attached) ----
DSPARK_MODEL="deepseek-ai/DeepSeek-V4-Flash-0731"
SERVED_MODEL_NAME="deepseek-v4-flash-0731"

# ---- Cluster topology ----
MASTER_ADDR="10.0.1.1"           # spark01 Port 1 IP (head node)
MASTER_PORT="25000"

# ---- RoCE / InfiniBand (dual-port) ----
NCCL_IB_DISABLE="0"
NCCL_IB_HCA="rocep1s0f0,roceP2p1s0f0"
NCCL_IB_GID_INDEX="4,4"          # spark02 default; spark01 uses "2,2"
NCCL_SOCKET_IFNAME="enP7s7"
GLOO_SOCKET_IFNAME="enP7s7"
TP_SOCKET_IFNAME="enP7s7"
NCCL_CROSS_NIC="1"
NCCL_IGNORE_CPU_AFFINITY="1"
NCCL_DEBUG="WARN"

# ---- Per-node VLLM_HOST_IP (fabric IP for ZeroMQ) ----
VLLM_HOST_IP="10.0.1.2"

# ---- CUDA compilation targets (GB10 = SM121) ----
TORCH_CUDA_ARCH_LIST="12.1a"
FLASHINFER_CUDA_ARCH_LIST="12.1a"

# ---- 0731 CURRENT BEST profile ----
MAX_MODEL_LEN="1048576"          # 1M — model's true YaRN ceiling
MAX_NUM_SEQS="6"                 # 6 slots (issue-#8 OOM trigger is 12/0.85)
MAX_NUM_BATCHED_TOKENS="8192"
GPU_MEMORY_UTILIZATION="0.78"
MTP_NUM_TOKENS="5"               # k=5 verified default; k<=5 locked on this runtime

# ---- Runtime image tag (variant03 builds this) ----
DSPARK_VLLM_IMAGE="vllm-dspark-runtime:dspark-nvfp4-stage-c-0731"

# ---- DSpark / NVFP4 tuning ----
VLLM_ALLOW_LONG_MAX_MODEL_LEN="1"
VLLM_USE_FLASHINFER_SAMPLER="1"
VLLM_USE_B12X_MOE="1"
VLLM_USE_B12X_WO_PROJECTION="1"
VLLM_DSPARK_GPU_REJECTED_CONTEXT_MASK="1"
VLLM_DSPARK_REPLICATE_MARKOV_W1="1"
VLLM_DSPARK_LOCAL_ARGMAX="1"
VLLM_DSPARK_CONFIDENCE_THRESHOLD="0.0"
VLLM_DSPARK_CONFIDENCE_SCHEDULER="off"
VLLM_DSPARK_FUSED_MARKOV_ARGMAX="0"
VLLM_DSPARK_HARDWARE_SCHEDULER_EARLY_STOP="1"
VLLM_DSV4_B12X_COMPRESSED_MLA="0"

# ---- Warm-restart stability + long-context slot clamp ----
VLLM_ENGINE_READY_TIMEOUT_S="3600"
DSPARK_SLOT_CLAMP="1"