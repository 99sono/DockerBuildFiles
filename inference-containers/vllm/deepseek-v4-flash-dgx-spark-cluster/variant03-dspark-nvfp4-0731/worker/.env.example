# =============================================================================
# DeepSeek-V4-Flash-0731 DSpark NVFP4 — WORKER node environment (spark02)
# =============================================================================
# NOTE: NCCL_IB_GID_INDEX differs per node!
#   Head (spark01): IPv4 GIDs at index 2 -> GID_INDEX="2,2"
#   Worker (spark02): IPv4 GIDs at index 4 -> GID_INDEX="4,4"
# Run ./04_check_nccl.sh on each node to auto-detect.
# Profile: 0731 CURRENT BEST (1M ctx, 6 slots, gmu 0.78, k=5).
# =============================================================================

INFERENCE_API_KEY="dummy-key"
INFERENCE_MODEL_ALIAS="deepseek-v4-flash-0731"

DSPARK_MODEL="deepseek-ai/DeepSeek-V4-Flash-0731"
SERVED_MODEL_NAME="deepseek-v4-flash-0731"

DSPARK_VLLM_IMAGE="vllm-dspark-runtime:dspark-nvfp4-stage-c-0731"

MASTER_ADDR="10.0.1.1"
MASTER_PORT="25000"

NCCL_IB_DISABLE="0"
NCCL_IB_HCA="rocep1s0f0,roceP2p1s0f0"
NCCL_IB_GID_INDEX="4,4"          # Worker-specific!
NCCL_SOCKET_IFNAME="enP7s7"
GLOO_SOCKET_IFNAME="enP7s7"
TP_SOCKET_IFNAME="enP7s7"
NCCL_CROSS_NIC="1"
NCCL_IGNORE_CPU_AFFINITY="1"
NCCL_DEBUG="WARN"

VLLM_HOST_IP="10.0.1.2"

TORCH_CUDA_ARCH_LIST="12.1a"
FLASHINFER_CUDA_ARCH_LIST="12.1a"

MAX_MODEL_LEN="1048576"
MAX_NUM_SEQS="6"
MAX_NUM_BATCHED_TOKENS="8192"
GPU_MEMORY_UTILIZATION="0.78"
MTP_NUM_TOKENS="5"

VLLM_ALLOW_LONG_MAX_MODEL_LEN="1"
VLLM_USE_FLASHINFER_SAMPLER="1"
VLLM_USE_B12X_MOE="1"
VLLM_USE_B12X_WO_PROJECTION="1"
VLLM_DSPARK_GPU_REJECTED_CONTEXT_MASK="1"
VLLM_DSPARK_REPLICATE_MARKOV_W1="1"
VLLM_DSPARK_LOCAL_ARGMAX="1"
VLLM_DSPARK_CONFIDENCE_THRESHOLD="0.0"
VLLM_DSPARK_CONFIDENCE_SCHEDULER="off"
VLLM_DSPARK_FUSED_MARKOV_ARGMAX="0"
VLLM_DSPARK_HARDWARE_SCHEDULER_EARLY_STOP="1"
VLLM_DSV4_B12X_COMPRESSED_MLA="0"

VLLM_ENGINE_READY_TIMEOUT_S="3600"
DSPARK_SLOT_CLAMP="1"