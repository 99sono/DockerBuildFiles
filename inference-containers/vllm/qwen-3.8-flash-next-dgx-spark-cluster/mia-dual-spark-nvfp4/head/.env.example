# =============================================================================
# Qwen3.8-Flash-Next Mia NVFP4 — HEAD Node Environment (spark01)
# =============================================================================
# Copy to .env:
#   cp .env.example .env
# =============================================================================

INFERENCE_API_KEY="dummy-key"
INFERENCE_MODEL_ALIAS="qwen3.8-flash-next"
INFERENCE_MODEL="Mia-AiLab/Qwen3.8-Flash-Next-NVFP4"
INFERENCE_SERVER_PORT="8000"

VLLM_IMAGE="vllm/vllm-openai:qwen38-flash-next"

# Cluster / Distributed Coordination
MASTER_ADDR="10.0.1.1"
MASTER_PORT="25000"
VLLM_HOST_IP="10.0.1.1"

# ConnectX-7 RoCE InfiniBand Settings (spark01)
NCCL_IB_DISABLE="0"
NCCL_IB_HCA="rocep1s0f0,roceP2p1s0f0"
NCCL_IB_GID_INDEX="2,2"          # Head IPv4 GID index on spark01
NCCL_SOCKET_IFNAME="enP7s7"
GLOO_SOCKET_IFNAME="enP7s7"
TP_SOCKET_IFNAME="enP7s7"
NCCL_CROSS_NIC="1"
NCCL_IGNORE_CPU_AFFINITY="1"
NCCL_DEBUG="WARN"

# Memory and Serving Limits
INFERENCE_GPU_MEMORY_UTILIZATION="0.835"
INFERENCE_MAX_MODEL_LEN="262144"
INFERENCE_MAX_NUM_SEQS="8"
INFERENCE_MAX_NUM_BATCHED_TOKENS="8192"
INFERENCE_KV_CACHE_DTYPE="fp8"
