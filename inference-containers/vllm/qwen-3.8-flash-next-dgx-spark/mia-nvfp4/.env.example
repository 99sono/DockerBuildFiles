# =============================================================================
# .env.example — vLLM (Qwen3.8-Flash-Next NVFP4, DGX Spark TP=1)
# Copy to .env and edit. The .env file is gitignored.
# All variables use INFERENCE_ prefix (framework-agnostic).
# docker-compose.yml uses ${VAR:-default} syntax, so a .env is optional.
# =============================================================================

# API key for server authentication (--api-key flag)
INFERENCE_API_KEY=dummy-key

# Model alias exposed in /v1/models API (--served-model-name flag)
INFERENCE_MODEL_ALIAS=qwen3.8-flash-next

# Port mapping host:container (internal container port always 8000)
INFERENCE_SERVER_PORT=8000

# Client-facing URL for test scripts (DGX Spark uses nginx HTTPS proxy)
INFERENCE_SERVER_URL=https://localhost/inference/v1

# GPU memory utilization (Auto-capped by HOST_RESERVE_GIB)
INFERENCE_GPU_MEMORY_UTILIZATION=0.78

# Context length (262144 native, up to 524288 via YaRN)
INFERENCE_MAX_MODEL_LEN=262144

# Optional Hugging Face Token (if accessing gated resources)
# HF_TOKEN=hf_...
